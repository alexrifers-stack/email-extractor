body.pink-dark {
  --bg:           #1a0014;
  --bg-panel:     #230019;
  --bg-surface:   #2e0020;
  --bg-input:     #1e0017;
  --bg-hover:     #3a002a;
  --line:         rgba(244,114,182,0.16);
  --line-bright:  rgba(244,114,182,0.42);
  --accent:       #f472b6;
  --accent-dim:   rgba(244,114,182,0.14);
  --accent-glow:  rgba(244,114,182,0.32);
  --cyan:         #f9a8d4;
  --cyan-dim:     rgba(249,168,212,0.10);
  --text:         #fce7f3;
  --text-2:       #f9a8d4;
  --text-3:       #9d4e7a;
  --green:        #f472b6;
  --green-dim:    rgba(244,114,182,0.14);
  --red:          #f87171;
  --red-dim:      rgba(248,113,113,0.12);
  --blob-a:   #f472b6;
  --blob-b:   #4a0030;
  --blob-op:  0.20;
