        <svg class="icon" viewBox="0 0 24 24"><path d="M4 21V14M4 10V3M12 21v-8M12 9V3M20 21v-6M20 11V3M1 14h6M9 9h6M17 11h6"/></svg>
        Settings
      </div>
      <div class="card-body">
        <div class="grid2" style="gap:12px">
          <div class="field">
            <label>News ID <small>(overrides parsed ID)</small></label>
            <input id="tg-newsid" type="text" placeholder="e.g. 114811665" oninput="pinAndParse('tg-newsid','tg')">
          </div>
          <div class="field">
            <label>Campaign Name <small>(📤 List name)</small></label>
            <select id="tg-campaign" oninput="pinAndParse('tg-campaign','tg')" onchange="pinAndParse('tg-campaign','tg')">
              <option value="">auto-filled from feedback</option>
              <option value="CMH9_list_webautomat_9-4*4">CMH9_list_webautomat_9-4*4</option>
              <option value="CMH9_OLD_seeds_warmup">CMH9_OLD_seeds_warmup</option>
              <option value="CMH9_NEW_seeds_warmup">CMH9_NEW_seeds_warmup</option>
            </select>
          </div>
          <div class="field">
            <label>Pack Name</label>
            <input id="tg-pack" type="text" placeholder="auto-filled from feedback" oninput="pinAndParse('tg-pack','tg')">
          </div>
          <div class="field">
            <label>IP Limit (per IP) <small>(fallback only — per-IP value from feedback wins)</small></label>
            <input id="tg-limit" type="number" placeholder="24000" oninput="parseTelegram()">
          </div>
          <div class="field">
            <label>Start Time <small>(auto-filled from feedback)</small></label>
            <input id="tg-starttime" type="text" placeholder="HH:MM" oninput="pinAndParse('tg-starttime','tg')">
          </div>
          <div class="field">
            <label>End Time <small>(last drop, default 00:00)</small></label>
