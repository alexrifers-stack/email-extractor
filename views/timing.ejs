  <!-- TELEGRAM PANEL -->
  <div id="panel-tg" class="panel active">

    <div class="card fx-in" style="animation-delay:.1s">
      <div class="card-head">
        <svg class="icon" viewBox="0 0 24 24"><path d="M21 3 3 10.5l7.5 3M21 3l-6.5 18-4-7.5M21 3 10.5 13.5"/></svg>
