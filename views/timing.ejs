<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PMTA File Generator · CMH9 Tools</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap');

  :root {
    --bg-1:      #eef1f6;
    --bg-2:      #e2e8f2;
    --surface:   rgba(255,255,255,.86);
    --surface-solid: #ffffff;
    --panel:     #eceff5;
    --border:    #d9dfe8;
    --accent:    #0e7c72;
    --accent-soft: #12968a;
    --accent-glow: rgba(14,124,114,.30);
    --accent-ink:#ffffff;
    --accent2:   #a8630f;
    --accent2-glow: rgba(168,99,15,.26);
    --warn:      #b45309;
    --danger:    #b42318;
    --text:      #10141c;
    --muted:     #5c6472;
    --term-bg:   #0a0e13;
    --term-fg:   #35d488;
    --term-chrome:#6b7280;
    --shadow:    0 1px 2px rgba(16,24,40,.05), 0 10px 30px -12px rgba(16,24,40,.12);
    --shadow-lg: 0 20px 50px -20px rgba(16,24,40,.22);
    --mono:      'JetBrains Mono', monospace;
    --sans:      'Inter', sans-serif;
    --radius:    8px;
    --blob-a:    #0e7c72;
    --blob-b:    #a8630f;
    --blob-op:   .16;
    color-scheme: light;
  }

  html[data-theme="dark"] {
    --bg-1:      #060910;
    --bg-2:      #0b111b;
    --surface:   rgba(18,23,33,.68);
    --surface-solid: #11161f;
    --panel:     rgba(24,30,42,.7);
    --border:    rgba(148,163,184,.14);
    --accent:    #2dd4bf;
    --accent-soft: #5eead4;
    --accent-glow: rgba(45,212,191,.38);
    --accent-ink:#062420;
    --accent2:   #f2b166;
    --accent2-glow: rgba(242,177,102,.30);
    --warn:      #f0a94d;
    --danger:    #f2696e;
    --text:      #e8ebf1;
    --muted:     #8a93a3;
    --term-bg:   #05070a;
    --term-fg:   #3fe08f;
    --term-chrome:#4b5563;
    --shadow:    0 1px 2px rgba(0,0,0,.4), 0 20px 40px -16px rgba(0,0,0,.55);
    --shadow-lg: 0 30px 70px -24px rgba(0,0,0,.7);
    --blob-a:    #2dd4bf;
    --blob-b:    #f2b166;
    --blob-op:   .22;
    color-scheme: dark;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
  }

  html { background: var(--bg-1); }

  body {
    font-family: var(--sans);
    background:
      radial-gradient(1100px 620px at 12% -8%, color-mix(in srgb, var(--blob-a) 10%, transparent), transparent 60%),
      radial-gradient(900px 560px at 108% 6%, color-mix(in srgb, var(--blob-b) 9%, transparent), transparent 60%),
      linear-gradient(180deg, var(--bg-1), var(--bg-2));
    color: var(--text);
    min-height: 100vh;
    padding: 28px 20px 60px;
    font-size: 12.5px;
    line-height: 1.45;
    max-width: 1360px;
    margin: 0 auto;
    position: relative;
    transition: background .25s ease, color .25s ease;
  }

  .icon { width: 14px; height: 14px; flex-shrink: 0; stroke: currentColor; fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

  /* ── Ambient background FX ── */
  .bg-fx {
    position: fixed;
    inset: 0;
    overflow: hidden;
    z-index: -1;
    pointer-events: none;
  }
  .bg-fx .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: var(--blob-op);
    will-change: transform;
  }
  .bg-fx .blob-1 {
    width: 520px; height: 520px;
    background: var(--blob-a);
    top: -180px; left: -140px;
    animation: floatA 24s ease-in-out infinite;
  }
  .bg-fx .blob-2 {
    width: 460px; height: 460px;
    background: var(--blob-b);
    bottom: -200px; right: -120px;
    animation: floatB 28s ease-in-out infinite;
  }
  .bg-fx .blob-3 {
    width: 380px; height: 380px;
    background: var(--blob-a);
    top: 32%; left: 62%;
    opacity: calc(var(--blob-op) * .7);
    animation: floatC 32s ease-in-out infinite;
  }
  .bg-fx .grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--text) 5%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--text) 5%, transparent) 1px, transparent 1px);
    background-size: 44px 44px;
    opacity: .25;
    mask-image: radial-gradient(ellipse 70% 55% at 50% 0%, #000 30%, transparent 75%);
  }
  @keyframes floatA {
    0%, 100% { transform: translate(0,0) scale(1); }
    50%      { transform: translate(70px, 50px) scale(1.12); }
  }
  @keyframes floatB {
    0%, 100% { transform: translate(0,0) scale(1); }
    50%      { transform: translate(-60px, -40px) scale(1.08); }
  }
  @keyframes floatC {
    0%, 100% { transform: translate(0,0) scale(1); }
    50%      { transform: translate(-40px, 60px) scale(1.15); }
  }

  /* ── Entrance animation ── */
  @keyframes fxIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .fx-in { animation: fxIn .55s cubic-bezier(.16,1,.3,1) both; }

  /* ── Two-column layout ── */
  .layout {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }
  .col-left {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .col-right {
    flex: 1 1 420px;
    min-width: 0;
    position: sticky;
    top: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  @media (max-width: 860px) {
    .layout { flex-direction: column; }
    .col-right { position: static; width: 100%; }
  }

  /* ── App shell: sidebar + main content ── */
  .app-shell { display: flex; align-items: stretch; gap: 24px; }
  .app-main  { flex: 1 1 auto; min-width: 0; }

  .app-sidebar {
    flex: 0 0 200px;
    width: 200px;
    position: sticky;
    top: 20px;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 16px 12px;
    gap: 4px;
  }
  .sidebar-brand {
    display: flex; align-items: center; gap: 9px;
    padding: 0 4px 14px; margin-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }
  .sidebar-logo {
    width: 30px; height: 30px; border-radius: 9px; flex-shrink: 0;
    background: linear-gradient(150deg, var(--accent), var(--accent-soft));
    display: grid; place-items: center; font-size: 13px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent), 0 6px 16px -6px var(--accent-glow);
  }
  .sidebar-brand-name { font-family: var(--mono); font-weight: 700; font-size: 0.74rem; color: var(--text); letter-spacing: -0.01em; }
  .sidebar-brand-sub  { font-size: 0.58rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 1px; }
  .sidebar-nav { display: flex; flex-direction: column; gap: 3px; }
  .sidebar-link {
    display: flex; align-items: center; gap: 9px;
    padding: 8px 9px; border-radius: calc(var(--radius) - 2px);
    color: var(--muted); text-decoration: none;
    font-family: var(--sans); font-size: 0.73rem; font-weight: 600;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }
  .sidebar-link-icon { width: 15px; height: 15px; display: grid; place-items: center; flex-shrink: 0; }
  .sidebar-link-icon svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .sidebar-link:hover { background: var(--panel); color: var(--text); transform: translateX(1px); }
  .sidebar-link.is-active { background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent); }
  .sidebar-foot {
    display: flex; align-items: center; gap: 6px;
    padding: 10px 7px 0; margin-top: auto;
    border-top: 1px solid var(--border);
    font-size: 0.58rem; color: var(--muted);
  }
  .sidebar-foot-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); opacity: 0.6; flex-shrink: 0; }
  @media (max-width: 900px) {
    .app-shell { flex-direction: column; }
    .app-sidebar {
      position: static; width: 100%; flex: none;
      flex-direction: row; align-items: center;
      padding: 8px 10px; gap: 8px; overflow-x: auto;
    }
    .sidebar-brand { border-bottom: none; margin-bottom: 0; padding: 0 10px 0 0; border-right: 1px solid var(--border); flex-shrink: 0; }
    .sidebar-nav { flex-direction: row; }
    .sidebar-link-label { display: none; }
    .sidebar-foot { display: none; }
  }

  /* ── Header ── */
  header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .logo {
    width: 32px; height: 32px;
    background: linear-gradient(150deg, var(--accent), var(--accent-soft));
    color: var(--accent-ink);
    border-radius: 9px;
    display: grid; place-items: center;
    font-family: var(--mono);
    font-weight: 700;
    font-size: 13px;
    flex-shrink: 0;
    letter-spacing: -0.02em;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent), 0 6px 18px -6px var(--accent-glow);
    animation: logoPulse 3.6s ease-in-out infinite;
    transition: transform .25s ease;
  }
  .logo:hover { transform: scale(1.06) rotate(-3deg); }
  @keyframes logoPulse {
    0%, 100% { box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent), 0 6px 18px -6px var(--accent-glow); }
    50%      { box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent), 0 10px 26px -4px var(--accent-glow); }
  }
  header .title { flex: 1; min-width: 0; }
  header h1 {
    font-family: var(--mono);
    font-size: 0.96rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
    background: linear-gradient(90deg, var(--text), var(--text) 60%, var(--accent-soft));
    -webkit-background-clip: text;
    background-clip: text;
  }
  header p  { font-size: 0.7rem; color: var(--muted); margin-top: 2px; }

  .theme-toggle {
    width: 32px; height: 32px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--surface);
    backdrop-filter: blur(10px);
    color: var(--muted);
    cursor: pointer;
    display: grid; place-items: center;
    flex-shrink: 0;
    transition: all .2s ease;
    box-shadow: var(--shadow);
  }
  .theme-toggle:hover { color: var(--accent); border-color: var(--accent); box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 30%, transparent), 0 8px 20px -8px var(--accent-glow); transform: translateY(-1px); }
  .theme-toggle .icon { width: 15px; height: 15px; transition: transform .4s cubic-bezier(.16,1,.3,1); }
  .theme-toggle.spin .icon { transform: rotate(180deg); }
  html[data-theme="dark"] .theme-toggle .icon-moon { display: none; }
  html:not([data-theme="dark"]) .theme-toggle .icon-sun { display: none; }

  /* ── Tabs ── */
  .tabs {
    position: relative;
    display: flex;
    gap: 3px;
    background: var(--surface);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 4px;
    margin-bottom: 16px;
    box-shadow: var(--shadow);
  }
  .tab-indicator {
    position: absolute;
    top: 4px; bottom: 4px; left: 4px;
    width: calc(50% - 5.5px);
    background: linear-gradient(135deg, var(--accent), var(--accent-soft));
    border-radius: 7px;
    box-shadow: 0 6px 18px -6px var(--accent-glow), 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);
    transition: transform .38s cubic-bezier(.16,1,.3,1);
    z-index: 0;
  }
  .tab {
    position: relative;
    z-index: 1;
    flex: 1;
    padding: 8px 10px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--muted);
    background: transparent;
    transition: color 0.2s ease;
    display: flex; align-items: center; justify-content: center; gap: 6px;
  }
  .tab.active { color: var(--accent-ink); }
  .tab:not(.active):hover { color: var(--text); }

  /* ── Panel ── */
  .panel { display: none; flex-direction: column; gap: 12px; }
  .panel.active { display: flex; }

  /* ── Card ── */
  .card {
    position: relative;
    background: var(--surface);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: box-shadow .3s ease, transform .3s ease, border-color .3s ease;
  }
  .card::after {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    opacity: .75;
  }
  .card::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 0%), var(--accent-glow), transparent 65%);
    opacity: 0;
    transition: opacity .35s ease;
    pointer-events: none;
  }
  .card:hover::before { opacity: .12; }
  .card:hover { box-shadow: var(--shadow-lg); border-color: color-mix(in srgb, var(--accent) 25%, var(--border)); }
  .card-head {
    padding: 9px 12px;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; gap: 7px;
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
  }
  .card-head .icon { color: var(--accent); }
  .card-body { padding: 12px; }

  /* ── Inputs ── */
  textarea {
    width: 100%;
    background: color-mix(in srgb, var(--panel) 70%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.74rem;
    padding: 9px 10px;
    resize: vertical;
    min-height: 120px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background .2s ease;
    line-height: 1.5;
  }
  textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); background: var(--surface-solid); }
  textarea::placeholder { color: var(--muted); }

  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

  .field label {
    display: block;
    font-family: var(--mono);
    font-size: 0.63rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .field label small { font-family: var(--sans); text-transform: none; letter-spacing: 0; }
  .field input, .field select {
    width: 100%;
    background: color-mix(in srgb, var(--panel) 70%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.76rem;
    padding: 7px 9px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background .2s ease;
  }
  .field input:focus, .field select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); background: var(--surface-solid); }
  .field input::placeholder { color: var(--muted); font-family: var(--sans); }
  .field select { cursor: pointer; }

  /* ── Alert ── */
  .alert {
    padding: 8px 12px;
    border-radius: var(--radius);
    font-size: 0.74rem;
    display: none;
    border-left: 3px solid transparent;
    animation: fxIn .3s ease both;
  }
  .alert.error  { background: color-mix(in srgb, var(--danger) 10%, transparent); border-left-color: var(--danger); color: var(--danger); }

  /* ── Output / terminal chrome ── */
  .out-label {
    font-family: var(--mono);
    font-size: 0.64rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin-bottom: 5px;
  }
  .term {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 12px 30px -18px rgba(0,0,0,.5);
  }
  .term-bar {
    background: var(--panel);
    border-bottom: 1px solid var(--border);
    padding: 6px 9px;
    display: flex; align-items: center; gap: 7px;
  }
  .term-dots { display: flex; gap: 4px; }
  .term-dots span { width: 6px; height: 6px; border-radius: 50%; background: var(--term-chrome); opacity: .55; }
  .term-name { font-family: var(--mono); font-size: 0.66rem; color: var(--muted); flex: 1; }
  .term-count { font-family: var(--mono); font-size: 0.62rem; color: var(--muted); }
  .out-box {
    background: var(--term-bg);
    padding: 10px;
    font-family: var(--mono);
    font-size: 0.7rem;
    white-space: pre;
    overflow-x: auto;
    max-height: 220px;
    overflow-y: auto;
    color: var(--term-fg);
    min-height: 40px;
    line-height: 1.6;
    text-shadow: 0 0 12px color-mix(in srgb, var(--term-fg) 35%, transparent);
  }
  .out-pair { display: flex; flex-direction: column; gap: 12px; }

  /* ── Preview placeholder (right column empty state) ── */
  .preview-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
    padding: 44px 22px;
    min-height: 260px;
    border: 1px dashed var(--border);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    box-shadow: none;
  }
  .preview-placeholder::after { display: none; }
  .preview-placeholder .icon-lg {
    width: 26px; height: 26px;
    stroke: currentColor; fill: none; stroke-width: 1.5;
    color: var(--muted);
    opacity: .6;
    margin-bottom: 2px;
  }
  .preview-placeholder h3 {
    font-family: var(--mono);
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.01em;
  }
  .preview-placeholder p {
    font-size: 0.72rem;
    color: var(--muted);
    max-width: 280px;
  }

  /* ── Buttons ── */
  .btn-row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
  .btn {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 13px;
    border: 1px solid transparent; border-radius: var(--radius);
    cursor: pointer;
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    transition: transform 0.18s ease, box-shadow 0.25s ease, filter .18s ease;
  }
  .btn::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(115deg, transparent 20%, rgba(255,255,255,.35) 45%, transparent 65%);
    transform: translateX(-120%);
    transition: transform .55s ease;
    z-index: 1;
    pointer-events: none;
  }
  .btn:hover::before { transform: translateX(120%); }
  .btn > * { position: relative; z-index: 2; }
  .btn-primary   { background: linear-gradient(135deg, var(--accent), var(--accent-soft)); color: var(--accent-ink); }
  .btn-primary:hover { box-shadow: 0 10px 24px -8px var(--accent-glow); }
  .btn-secondary { background: linear-gradient(135deg, var(--accent2), color-mix(in srgb, var(--accent2) 70%, #fff)); color: #ffffff; }
  .btn-secondary:hover { box-shadow: 0 10px 24px -8px var(--accent2-glow); }
  .btn-ghost     { background: var(--surface); color: var(--text); border-color: var(--border); }
  .btn-ghost:hover { background: var(--panel); border-color: color-mix(in srgb, var(--accent) 40%, var(--border)); }
  .btn:hover { transform: translateY(-1px); filter: brightness(1.04); }
  .btn:active { transform: translateY(0) scale(.98); }
  .btn .ripple {
    position: absolute;
    border-radius: 50%;
    background: rgba(255,255,255,.55);
    transform: scale(0);
    animation: rippleAnim .6s ease-out forwards;
    pointer-events: none;
    z-index: 1;
  }
  @keyframes rippleAnim { to { transform: scale(2.6); opacity: 0; } }

  /* ── Parsed info chips ── */
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .chip {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 3px 8px;
    font-size: 0.66rem;
    color: var(--muted);
    font-family: var(--sans);
    animation: fxIn .35s cubic-bezier(.16,1,.3,1) both;
    transition: border-color .2s ease, transform .2s ease;
  }
  .chip:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); transform: translateY(-1px); }
  .chip strong { color: var(--text); font-weight: 600; font-family: var(--mono); }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 5px; height: 5px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--accent); }
</style>
</head>
<body>

<div class="bg-fx" aria-hidden="true">
  <div class="grid"></div>
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>
</div>

<div class="app-shell">
<%- include('sidebar', { navItems: navItems, activeNav: activeNav }) %>
<div class="app-main">
<div class="layout">

<!-- ══════════════════════════════════════════ -->
<!-- LEFT COLUMN — header, tabs, input forms   -->
<!-- ══════════════════════════════════════════ -->
<div class="col-left">

  <header class="fx-in">
    <div class="logo">&gt;_</div>
    <div class="title">
      <h1>PMTA File Generator</h1>
      <p>Parse feedback &rarr; generate IPs &amp; Offset files</p>
    </div>
    <button class="theme-toggle" id="theme-toggle" onclick="toggleTheme()" title="Toggle light/dark mode">
      <svg class="icon icon-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="icon icon-moon" viewBox="0 0 24 24"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"/></svg>
    </button>
  </header>

  <!-- TABS -->
  <div class="tabs fx-in" style="animation-delay:.06s" id="tabs">
    <div class="tab-indicator" id="tab-indicator"></div>
    <button class="tab active" onclick="switchTab('tg')">
      <svg class="icon" viewBox="0 0 24 24"><path d="M21 3 3 10.5l7.5 3M21 3l-6.5 18-4-7.5M21 3 10.5 13.5"/></svg>
      Telegram Feedback
    </button>
    <button class="tab" onclick="switchTab('fl')">
      <svg class="icon" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8M8 9h2"/></svg>
