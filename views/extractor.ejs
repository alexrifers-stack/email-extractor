<!DOCTYPE html>
<html lang="en">
<head>
    <title>Email Extraction CMH9</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg:            #07090f;
            --bg-panel:      #0c0f1a;
            --bg-surface:    #111520;
            --bg-input:      #0e1219;
            --bg-hover:      #161b28;
            --line:          rgba(255,255,255,0.06);
            --line-bright:   rgba(96,165,250,0.25);
            --accent:        #3b82f6;
            --accent-dim:    rgba(59,130,246,0.15);
            --accent-glow:   rgba(59,130,246,0.4);
            --cyan:          #22d3ee;
            --cyan-dim:      rgba(34,211,238,0.12);
            --text:          #e8edf5;
            --text-2:        #7c8ba1;
            --text-3:        #3d4a5c;
            --green:         #34d399;
            --red:           #f87171;
            --red-dim:       rgba(248,113,113,0.1);
            --r:             12px;
            --r-sm:          8px;
        }

        .lm {
            --bg:            #f3f6fc;
            --bg-panel:      #ffffff;
            --bg-surface:    #f0f4fb;
            --bg-input:      #eef2fa;
            --bg-hover:      #e8eef9;
            --line:          rgba(0,0,0,0.07);
            --line-bright:   rgba(59,130,246,0.3);
            --accent:        #2563eb;
            --accent-dim:    rgba(37,99,235,0.1);
            --accent-glow:   rgba(37,99,235,0.25);
            --cyan:          #0891b2;
            --cyan-dim:      rgba(8,145,178,0.1);
            --text:          #0d1420;
            --text-2:        #4b5c73;
            --text-3:        #9badc4;
            --green:         #059669;
            --red:           #dc2626;
            --red-dim:       rgba(220,38,38,0.08);
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            transition: background 0.35s, color 0.35s;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed; inset: 0; z-index: 0; pointer-events: none;
            background-image:
                radial-gradient(ellipse 80% 50% at 10% 0%, rgba(59,130,246,0.08) 0%, transparent 60%),
                radial-gradient(ellipse 60% 40% at 90% 100%, rgba(34,211,238,0.06) 0%, transparent 55%),
                linear-gradient(rgba(255,255,255,0.018) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.018) 1px, transparent 1px);
            background-size: 100% 100%, 100% 100%, 48px 48px, 48px 48px;
        }

        .wrap {
            position: relative; z-index: 1;
            max-width: 1060px;
            margin: 0 auto;
            padding: 36px 24px 60px;
        }

        /* ── TOP BAR ── */
        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 32px;
        }

        .brand { display: flex; align-items: center; gap: 14px; }

        .brand-logo {
            width: 48px; height: 48px;
            border-radius: 14px;
            background: linear-gradient(140deg, #1d4ed8 0%, #0e7490 100%);
            display: flex; align-items: center; justify-content: center;
            font-size: 22px;
            box-shadow: 0 0 0 1px rgba(59,130,246,0.35), 0 8px 24px rgba(59,130,246,0.3);
            flex-shrink: 0;
        }

        .brand-name {
            font-size: 1.2rem; font-weight: 800;
            letter-spacing: -0.03em; color: var(--text);
        }

        .brand-tag {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.65rem; font-weight: 500;
            color: var(--accent); letter-spacing: 0.1em;
            text-transform: uppercase; margin-top: 4px;
        }

        .topbar-right { display: flex; align-items: center; gap: 10px; }

        .status-pill {
            display: flex; align-items: center; gap: 7px;
            font-size: 0.72rem; font-weight: 600;
            font-family: 'IBM Plex Mono', monospace; letter-spacing: 0.05em;
            padding: 7px 14px; border-radius: 99px;
            border: 1px solid var(--line); background: var(--bg-surface);
            color: var(--text-2);
        }

        .status-dot {
            width: 7px; height: 7px; border-radius: 50%;
            background: var(--text-3);
        }
        .status-dot.on {
            background: var(--green); box-shadow: 0 0 6px var(--green);
            animation: blink 2s ease infinite;
        }
        @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.4} }

        #themeBtn {
            width: 40px; height: 40px;
            border: 1px solid var(--line); background: var(--bg-surface);
            border-radius: var(--r-sm); font-size: 16px; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.2s; color: var(--text-2);
        }
        #themeBtn:hover { border-color: var(--accent); color: var(--accent); box-shadow: 0 0 0 3px var(--accent-dim); }

        /* ── LAYOUT ── */
        .layout {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 20px;
            align-items: start;
        }
        @media (max-width: 820px) { .layout { grid-template-columns: 1fr; } }

        /* ── PANEL ── */
        .panel {
            background: var(--bg-panel);
            border: 1px solid var(--line);
            border-radius: 18px; overflow: hidden;
            box-shadow: 0 1px 0 var(--line), 0 24px 48px rgba(0,0,0,0.35);
            transition: background 0.35s, border-color 0.35s;
            animation: fadeUp 0.4s ease both;
        }
        .lm .panel { box-shadow: 0 1px 0 var(--line), 0 8px 32px rgba(0,0,0,0.07); }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(14px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .panel-head {
            padding: 18px 24px 16px;
            border-bottom: 1px solid var(--line);
            display: flex; align-items: center; gap: 10px;
        }

        .panel-ico {
            width: 30px; height: 30px; border-radius: 8px;
            display: flex; align-items: center; justify-content: center; font-size: 14px;
        }
        .ico-blue { background: var(--accent-dim); }
        .ico-cyan { background: var(--cyan-dim); }

        .panel-title {
            font-size: 0.73rem; font-weight: 700;
            letter-spacing: 0.07em; text-transform: uppercase;
            color: var(--text-2); font-family: 'IBM Plex Mono', monospace;
        }

        .panel-body { padding: 22px 24px; }

        /* ── FIELD ── */
        .field { margin-bottom: 15px; }
        .field:last-child { margin-bottom: 0; }

        .f-label {
            font-size: 0.71rem; font-weight: 700;
            letter-spacing: 0.05em; text-transform: uppercase;
            color: var(--text-2); display: block; margin-bottom: 7px;
        }

        .f-input {
            width: 100%; height: 42px;
            background: var(--bg-input); border: 1px solid var(--line);
            border-radius: var(--r-sm); color: var(--text);
            font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.875rem;
            padding: 0 14px; outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            -webkit-appearance: none;
        }
        .f-input:focus { border-color: var(--line-bright); box-shadow: 0 0 0 3px var(--accent-dim); }
        .f-input::placeholder { color: var(--text-3); }
        .f-input option { background: var(--bg-panel); color: var(--text); }

        .input-wrap { position: relative; }

        .eye-btn {
            position: absolute; right: 12px; top: 50%;
            transform: translateY(-50%);
            font-size: 14px; color: var(--text-3); cursor: pointer;
            transition: color 0.2s;
        }
        .eye-btn:hover { color: var(--accent); }

        .field-hint {
            margin-top: 8px;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.69rem; font-weight: 500;
            color: var(--accent);
            display: flex; align-items: center; gap: 6px;
        }

        /* ── CONNECT BTN ── */
        .btn-connect {
            width: 100%; height: 42px;
            background: var(--accent-dim); border: 1px solid rgba(59,130,246,0.3);
            border-radius: var(--r-sm); color: var(--accent);
            font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.85rem; font-weight: 700;
            cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
            transition: all 0.2s; margin-top: 8px;
        }
        .btn-connect:hover {
            background: var(--accent); color: #fff; border-color: var(--accent);
            box-shadow: 0 4px 20px var(--accent-glow); transform: translateY(-1px);
        }

        /* ── MODE CARDS ── */
        .mode-stack { display: flex; flex-direction: column; gap: 8px; }

        .mode-card { position: relative; cursor: pointer; }
        .mode-card input[type="radio"] { position: absolute; opacity: 0; width: 0; height: 0; }

        .mode-inner {
            display: flex; align-items: center; gap: 12px;
            padding: 12px 15px; border: 1px solid var(--line);
            border-radius: var(--r-sm); background: var(--bg-surface);
            transition: all 0.2s; cursor: pointer;
        }
        .mode-inner:hover { border-color: rgba(59,130,246,0.3); background: var(--bg-hover); }

        .mode-card input:checked + .mode-inner {
            border-color: var(--accent); background: var(--accent-dim);
            box-shadow: inset 0 0 0 1px var(--accent);
        }

        .mode-ico {
            width: 34px; height: 34px; border-radius: 9px;
            background: var(--line); display: flex; align-items: center; justify-content: center;
            font-size: 15px; flex-shrink: 0; transition: background 0.2s;
        }
        .mode-card input:checked + .mode-inner .mode-ico { background: var(--accent); }

        .mode-title { font-size: 0.82rem; font-weight: 700; color: var(--text); }
        .mode-desc  { font-size: 0.7rem; color: var(--text-2); margin-top: 2px; }

        .radio-ring {
            width: 18px; height: 18px; border: 2px solid var(--text-3);
            border-radius: 50%; margin-left: auto; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.2s;
        }
        .mode-card input:checked + .mode-inner .radio-ring {
            border-color: var(--accent); background: var(--accent);
        }
        .mode-card input:checked + .mode-inner .radio-ring::after {
            content: ''; width: 6px; height: 6px;
            border-radius: 50%; background: #fff;
        }

        /* ── PARAMS GRID ── */
        .right-col { display: flex; flex-direction: column; gap: 20px; }

        .params-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

        /* ── CLEAN OPTIONS ── */
        .clean-box { display: none; animation: revealDown 0.22s ease; }
        @keyframes revealDown {
            from { opacity: 0; transform: translateY(-6px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .clean-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 18px; }

        .divider { height: 1px; background: var(--line); margin: 16px 0; }

        .checks-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; }
        @media (max-width: 620px) { .checks-grid { grid-template-columns: 1fr 1fr; } }

        .check-tile {
            display: flex; align-items: center; gap: 9px;
            padding: 10px 13px; border: 1px solid var(--line);
            border-radius: var(--r-sm); background: var(--bg-surface);
            cursor: pointer; transition: all 0.15s;
        }
        .check-tile:hover { border-color: rgba(59,130,246,0.3); background: var(--bg-hover); }

        .check-tile input[type="checkbox"] {
            width: 15px; height: 15px;
            accent-color: var(--accent); cursor: pointer; flex-shrink: 0;
        }
        .check-tile span { font-size: 0.76rem; font-weight: 500; color: var(--text-2); }

        /* ── HEADERS ONLY PARAMS ── */
        .headers-box { display: none; animation: revealDown 0.22s ease; }

        .headers-3col { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; margin-bottom: 14px; }
        .headers-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
        @media (max-width: 620px) {
            .headers-3col { grid-template-columns: 1fr 1fr; }
            .headers-2col { grid-template-columns: 1fr; }
        }

        .f-mono {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.8rem;
        }

        /* ── EXTRACT BTN ── */
        .btn-extract {
            width: 100%; height: 52px;
            background: linear-gradient(135deg, #2563eb 0%, #0891b2 100%);
            border: none; border-radius: var(--r-sm);
            color: #fff; font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.92rem; font-weight: 800; letter-spacing: 0.02em;
            cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px;
            transition: all 0.25s; position: relative; overflow: hidden;
            box-shadow: 0 4px 24px rgba(37,99,235,0.35);
        }
        .btn-extract::after {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.12), transparent);
            opacity: 0; transition: opacity 0.2s;
        }
        .btn-extract:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(37,99,235,0.5); }
        .btn-extract:hover::after { opacity: 1; }
        .btn-extract:active { transform: translateY(0); }
        .btn-extract:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }

        /* ── LOADING ── */
        .loading-wrap {
            margin-top: 14px; background: var(--bg-surface);
            border: 1px solid var(--line); border-radius: var(--r-sm);
            padding: 16px 20px; display: none;
        }
        .loading-top { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
        .spin {
            width: 20px; height: 20px;
            border: 2px solid var(--line); border-top-color: var(--accent);
            border-radius: 50%; animation: spin 0.7s linear infinite; flex-shrink: 0;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .loading-txt { font-family: 'IBM Plex Mono', monospace; font-size: 0.75rem; color: var(--text-2); }

        .progress-rail { height: 3px; background: var(--line); border-radius: 99px; overflow: hidden; }
        .progress-fill {
            height: 100%; background: linear-gradient(90deg, var(--accent), var(--cyan));
            border-radius: 99px; width: 0%; transition: width 0.3s ease; position: relative;
        }
        .progress-fill::after {
            content: ''; position: absolute; top: 0; bottom: 0; width: 60px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent);
            animation: sweep 1.2s linear infinite;
        }
        @keyframes sweep { from { left: -60px; } to { left: 100%; } }

        /* ── LOGOUT ── */
        .btn-logout {
            display: flex; align-items: center; justify-content: center; gap: 8px;
            width: 100%; height: 42px; background: transparent;
            border: 1px solid rgba(248,113,113,0.2); border-radius: var(--r-sm);
            color: var(--red); font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.82rem; font-weight: 600; text-decoration: none;
            cursor: pointer; transition: all 0.2s; margin-top: 10px;
        }
        .btn-logout:hover { background: var(--red-dim); border-color: rgba(248,113,113,0.4); color: var(--red); }

        /* ── ERROR ── */
        .err-box {
            display: flex; align-items: center; gap: 10px;
            padding: 12px 16px; background: var(--red-dim);
            border: 1px solid rgba(248,113,113,0.2);
            border-radius: var(--r-sm); font-size: 0.8rem; color: var(--red); margin-top: 10px;
        }

        /* ── FOOTER ── */
        .foot {
            margin-top: 40px; padding-top: 28px;
            border-top: 1px solid var(--line);
            display: flex; align-items: center; justify-content: space-between;
            flex-wrap: wrap; gap: 16px;
        }
        .foot-brand { display: flex; align-items: center; gap: 10px; }
        .foot-logo {
            width: 30px; height: 30px; border-radius: 9px;
            background: linear-gradient(140deg, #1d4ed8, #0e7490);
            display: flex; align-items: center; justify-content: center; font-size: 14px;
        }
        .foot-name { font-size: 0.82rem; font-weight: 700; color: var(--text); }
        .foot-copy { font-family: 'IBM Plex Mono', monospace; font-size: 0.65rem; color: var(--text-3); display: block; margin-top: 2px; }

        .foot-links { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
        .foot-link {
            font-size: 0.75rem; font-weight: 500; color: var(--text-2);
            text-decoration: none; padding: 5px 12px; border-radius: 99px;
            border: 1px solid var(--line); transition: all 0.15s;
        }
        .foot-link:hover { border-color: var(--accent); color: var(--accent); }
        .foot-tg {
            font-size: 0.75rem; font-weight: 600; color: var(--accent);
            text-decoration: none; padding: 5px 14px; border-radius: 99px;
            border: 1px solid rgba(59,130,246,0.3); background: var(--accent-dim);
            display: flex; align-items: center; gap: 6px; transition: all 0.2s;
        }
        .foot-tg:hover { background: var(--accent); color: #fff; border-color: var(--accent); }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--bg); }
        ::-webkit-scrollbar-thumb { background: var(--line); border-radius: 99px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--accent); }
    </style>
</head>

<body>
<div class="wrap">

    <!-- TOP BAR -->
    <div class="topbar">
        <div class="brand">
            <div class="brand-logo">📧</div>
            <div>
                <div class="brand-name">Email Extraction</div>
                <div class="brand-tag">CMH9 &nbsp;·&nbsp; v2.0</div>
            </div>
        </div>
        <div class="topbar-right">
            <div class="status-pill">
                <div class="status-dot" id="connDot"></div>
                <span id="connLabel">Disconnected</span>
            </div>
            <button id="themeBtn" onclick="toggleTheme()" title="Toggle theme">
                <i class="bi bi-moon-stars-fill" id="themeIco"></i>
            </button>
        </div>
    </div>

    <!-- FORM -->
    <form method="POST">
    <div class="layout">

        <!-- ═══ LEFT SIDEBAR ═══ -->
        <div style="display:flex;flex-direction:column;gap:20px;">

            <!-- CONNECTION -->
            <div class="panel">
                <div class="panel-head">
                    <div class="panel-ico ico-blue">🔌</div>
                    <span class="panel-title">Connection</span>
                </div>
                <div class="panel-body">
                    <div class="field">
                        <label class="f-label">Email Address</label>
                        <input name="email" class="f-input" type="email" placeholder="you@gmail.com" required value="<%= email || '' %>">
                    </div>
                    <div class="field">
                        <label class="f-label">App Password</label>
                        <div class="input-wrap">
                            <input type="password" name="password" id="passwordInput" class="f-input"
                                style="padding-right:40px;" placeholder="xxxx xxxx xxxx xxxx" required value="<%= password || '' %>">
                            <span class="eye-btn" onclick="togglePassword()">
                                <i class="bi bi-eye" id="eyeIco"></i>
                            </span>
                        </div>
                    </div>
                    <button type="submit" formaction="/connect" class="btn-connect">
                        <i class="bi bi-plug-fill"></i> Connect to IMAP
                    </button>
                </div>
            </div>

            <!-- MODE -->
            <div class="panel">
                <div class="panel-head">
                    <div class="panel-ico ico-cyan">⚙️</div>
                    <span class="panel-title">Download Mode</span>
                </div>
                <div class="panel-body">
                    <div class="mode-stack">

                        <label class="mode-card">
                            <input type="radio" name="mode" value="clean" checked>
                            <div class="mode-inner">
                                <div class="mode-ico">🧹</div>
                                <div>
                                    <div class="mode-title">Clean Headers</div>
                                    <div class="mode-desc">News-style with header rewrite</div>
                                </div>
                                <div class="radio-ring"></div>
                            </div>
                        </label>

                        <label class="mode-card">
                            <input type="radio" name="mode" value="justtext">
                            <div class="mode-inner">
                                <div class="mode-ico">📝</div>
                                <div>
                                    <div class="mode-title">Text Only</div>
                                    <div class="mode-desc">Plain text body extraction</div>
                                </div>
                                <div class="radio-ring"></div>
                            </div>
                        </label>

                        <label class="mode-card">
                            <input type="radio" name="mode" value="original">
                            <div class="mode-inner">
                                <div class="mode-ico">📬</div>
                                <div>
                                    <div class="mode-title">Newsletter Original</div>
                                    <div class="mode-desc">Raw newsletter format</div>
                                </div>
                                <div class="radio-ring"></div>
                            </div>
                        </label>

                        <label class="mode-card">
                            <input type="radio" name="mode" value="headersonly">
                            <div class="mode-inner">
                                <div class="mode-ico">🗂️</div>
                                <div>
                                    <div class="mode-title">Headers Only</div>
                                    <div class="mode-desc">Cleaned headers with custom params</div>
                                </div>
                                <div class="radio-ring"></div>
                            </div>
                        </label>

                        <label class="mode-card">
                            <input type="radio" name="mode" value="bodyonly">
                            <div class="mode-inner">
                                <div class="mode-ico">📄</div>
                                <div>
                                    <div class="mode-title">Body Only</div>
                                    <div class="mode-desc">Raw HTML/text body, no headers</div>
                                </div>
                                <div class="radio-ring"></div>
                            </div>
                        </label>

                    </div>
                </div>
            </div>

        </div>

        <!-- ═══ RIGHT COLUMN ═══ -->
        <div class="right-col">

            <!-- PARAMETERS -->
            <div class="panel">
                <div class="panel-head">
                    <div class="panel-ico ico-blue">🎛️</div>
                    <span class="panel-title">Extraction Parameters</span>
                </div>
                <div class="panel-body">

                    <div class="field">
                        <label class="f-label">Label / Folder</label>
                        <select name="label" id="labelSelect" class="f-input">
                            <% if (labels.length > 0) { %>
                                <% labels.forEach(function(label) { %>
                                    <option value="<%= label.name %>" data-count="<%= label.count %>">
                                        <%= label.name %> (<%= label.count %>)
                                    </option>
                                <% }) %>
                            <% } else { %>
                                <option>Connect First</option>
                            <% } %>
                        </select>
                        <div class="field-hint" id="labelCount">
                            <i class="bi bi-envelope-fill" style="font-size:10px;"></i>
                            <span>0 emails in folder</span>
                        </div>
                    </div>

                    <div class="params-2col">
                        <div class="field">
                            <label class="f-label">Start From</label>
                            <input type="number" name="start" value="1" class="f-input" min="1">
                        </div>
                        <div class="field">
                            <label class="f-label">Limit</label>
                            <input type="number" name="limit" value="10" class="f-input" min="1">
                        </div>
                    </div>

                </div>
            </div>

            <!-- CLEAN OPTIONS (shown for "clean" mode) -->
            <div class="panel clean-box" id="cleanOptions">
                <div class="panel-head">
                    <div class="panel-ico ico-cyan">🛠️</div>
                    <span class="panel-title">Header Modification</span>
                </div>
                <div class="panel-body">
                    <div class="clean-2col">
                        <div class="field">
                            <label class="f-label">Domain Replacement</label>
                            <input name="domain" class="f-input" value="[RP]" placeholder="[RP]">
                        </div>
                        <div class="field">
                            <label class="f-label">Message-ID Tag</label>
                            <input name="eid" class="f-input" value="[EID]" placeholder="[EID]">
                        </div>
                    </div>

                    <div class="divider"></div>

                    <div class="checks-grid">
                        <label class="check-tile">
                            <input type="checkbox" name="replaceDate" checked>
                            <span>Replace Date</span>
                        </label>
                        <label class="check-tile">
                            <input type="checkbox" name="replaceTo" checked>
                            <span>Replace To</span>
                        </label>
                        <label class="check-tile">
                            <input type="checkbox" name="keepReceived" checked>
                            <span>Keep Received</span>
                        </label>
                        <label class="check-tile">
                            <input type="checkbox" name="keepReplyTo" checked>
                            <span>Keep Reply-To</span>
                        </label>
                        <label class="check-tile">
                            <input type="checkbox" name="addCc">
                            <span>Auto Add Cc</span>
                        </label>
                        <label class="check-tile">
                            <input type="checkbox" name="addSender">
                            <span>Add Sender</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- HEADERS ONLY OPTIONS (shown for "headersonly" mode) -->
            <div class="panel headers-box" id="headersOptions">
                <div class="panel-head">
                    <div class="panel-ico ico-cyan">🗂️</div>
                    <span class="panel-title">Headers Parameters</span>
                </div>
                <div class="panel-body">

                    <div class="headers-3col">
                        <div class="field">
                            <label class="f-label">From Name</label>
                            <input name="P_FRNAME" class="f-input f-mono" value="[P_FRNAME]" placeholder="[P_FRNAME]">
                        </div>
                        <div class="field">
                            <label class="f-label">Language Code</label>
                            <input name="LAN6" class="f-input f-mono" value="[6LAN]" placeholder="[6LAN]">
                        </div>
                        <div class="field">
                            <label class="f-label">Return Path</label>
                            <input name="P_RPATH" class="f-input f-mono" value="[P_RPATH]" placeholder="[P_RPATH]">
                        </div>
                    </div>

                    <div class="headers-2col">
                        <div class="field">
                            <label class="f-label">Subject Value</label>
                            <input name="SUBJECT_VAL" class="f-input f-mono" value="[S]" placeholder="[S]">
                        </div>
                        <div class="field">
                            <label class="f-label">Boundary</label>
                            <input name="BOUNDARY" class="f-input f-mono" value="[BND]" placeholder="[BND]">
                        </div>
                        <div class="field">
                             <label class="check-tile">
                            <input type="checkbox" name="addSender1">
                            <span>Add Sender</span>
                        </label>
                        </div>
                    </div>

                    <div class="field-hint" style="margin-top:4px;">
                        <i class="bi bi-info-circle" style="font-size:10px;"></i>
                        <span>Outputs cleaned headers only — body is stripped</span>
                    </div>

                </div>
            </div>

            <!-- ACTION -->
            <div class="panel">
                <div class="panel-body">
                    <button type="submit" formaction="/extract" class="btn-extract" id="extractBtn">
                        <i class="bi bi-lightning-charge-fill"></i> Start Extraction
                    </button>

                    <div class="loading-wrap" id="loadingBox">
                        <div class="loading-top">
                            <div class="spin"></div>
                            <span class="loading-txt">⏳ Extracting emails, please wait...</span>
                        </div>
                        <div class="progress-rail">
                            <div class="progress-fill" id="progressBar"></div>
                        </div>
                    </div>

                    <a href="/logout" class="btn-logout">
                        <i class="bi bi-box-arrow-left"></i> Logout
                    </a>

                    <% if (error) { %>
                    <div class="err-box">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <%= error %>
                    </div>
                    <% } %>
                </div>
            </div>

        </div>
    </div>
    </form>

    <!-- FOOTER -->
    <div class="foot">
        <div class="foot-brand">
            <div class="foot-logo">🚀</div>
            <div>
                <div class="foot-name">CMH9 Extractor</div>
                <span class="foot-copy">© <%= new Date().getFullYear() %> Karim Rachmoun — All rights reserved.</span>
            </div>
        </div>
        <div class="foot-links">
            <a href="#" class="foot-link">Terms</a>
            <a href="#" class="foot-link">Privacy</a>
            <a href="#" class="foot-link">Support</a>
            <a href="https://t.me/karim_rachmoun" target="_blank" class="foot-tg">
                <i class="bi bi-telegram"></i> Telegram
            </a>
        </div>
    </div>

</div>

<script>
    /* PASSWORD */
    function togglePassword() {
        const inp = document.getElementById('passwordInput');
        const ico = document.getElementById('eyeIco');
        inp.type = inp.type === 'password' ? 'text' : 'password';
        ico.className = inp.type === 'text' ? 'bi bi-eye-slash' : 'bi bi-eye';
    }

    /* MODE */
    const radios      = document.querySelectorAll("input[name='mode']");
    const cleanBox    = document.getElementById('cleanOptions');
    const headersBox  = document.getElementById('headersOptions');

    function syncMode() {
        const val = document.querySelector("input[name='mode']:checked").value;
        cleanBox.style.display   = val === 'clean'       ? 'block' : 'none';
        headersBox.style.display = val === 'headersonly' ? 'block' : 'none';
    }
    radios.forEach(r => r.addEventListener('change', syncMode));
    syncMode();

    /* LABEL COUNT */
    const labelSel = document.getElementById('labelSelect');
    const labelCnt = document.getElementById('labelCount');
    function updateCount() {
        if (!labelSel) return;
        const n = labelSel.options[labelSel.selectedIndex]?.getAttribute('data-count') || 0;
        labelCnt.innerHTML = '<i class="bi bi-envelope-fill" style="font-size:10px;"></i> <span>' + n + ' emails in folder</span>';
    }
    labelSel.addEventListener('change', updateCount);
    updateCount();

    /* THEME */
    function applyTheme(t) {
        const ico = document.getElementById('themeIco');
        document.body.classList.toggle('lm', t === 'light');
        ico.className = t === 'light' ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
        localStorage.setItem('theme', t);
    }
    function toggleTheme() {
        applyTheme(localStorage.getItem('theme') === 'light' ? 'dark' : 'light');
    }

    window.addEventListener('DOMContentLoaded', () => {
        applyTheme(localStorage.getItem('theme') || 'dark');
        const hasCred = '<%= email || "" %>' !== '';
        if (hasCred) {
            document.getElementById('connDot').classList.add('on');
            document.getElementById('connLabel').textContent = 'Connected';
        }
    });

    /* EXTRACT LOADING */
    const form        = document.querySelector('form');
    const loadingBox  = document.getElementById('loadingBox');
    const extractBtn  = document.getElementById('extractBtn');
    const progressBar = document.getElementById('progressBar');

    form.addEventListener('submit', () => {
        if (document.activeElement.getAttribute('formaction') === '/extract') {
            loadingBox.style.display = 'block';
            extractBtn.disabled = true;
            extractBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Processing...';
            let p = 0;
            const iv = setInterval(() => {
                p += Math.random() * 12;
                if (p > 88) p = 88;
                progressBar.style.width = p + '%';
            }, 300);
            setTimeout(() => {
                clearInterval(iv);
                progressBar.style.width = '100%';
                setTimeout(() => {
                    loadingBox.style.display = 'none';
                    extractBtn.disabled = false;
                    extractBtn.innerHTML = '<i class="bi bi-lightning-charge-fill"></i> Start Extraction';
                    progressBar.style.width = '0%';
                }, 600);
            }, 4000);
        }
    });
</script>
</body>
</html>
