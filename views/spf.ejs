/* ── SPF page: input/output grid ── */
.spf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
.spf-grid .panel-body { padding-top: 4px; }
@media (max-width: 780px) { .spf-grid { grid-template-columns: 1fr; } }
