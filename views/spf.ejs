<script>
document.getElementById('yr').textContent = new Date().getFullYear();

/* ── Theme (shared with the rest of the app) ── */
function applyTheme(t) {
  const ico = document.getElementById('themeIco');
  document.body.classList.remove('dm', 'pink', 'pink-light', 'pink-dark');
  if (t === 'dark')            document.body.classList.add('dm');
  else if (t === 'pink')       document.body.classList.add('pink');
  else if (t === 'pink-light') document.body.classList.add('pink-light');
  else if (t === 'pink-dark')  document.body.classList.add('pink-dark');
  const isPink = ['pink','pink-light','pink-dark'].includes(t);
  if (ico) ico.className = t === 'dark' ? 'bi bi-moon-stars-fill' : isPink ? 'bi bi-flower2' : 'bi bi-sun-fill';
  localStorage.setItem('cmh9theme', t);
  const ids = { 'pink': 'mode3BtnDark', 'pink-light': 'mode3BtnLight', 'pink-dark': 'mode3BtnDm' };
  ['mode3BtnDark','mode3BtnLight','mode3BtnDm'].forEach(id => {
    const btn = document.getElementById(id);
    if (btn) btn.classList.remove('is-active');
  });
  if (ids[t]) {
    const active = document.getElementById(ids[t]);
    if (active) active.classList.add('is-active');
  }
  const footAuthor = document.getElementById('footAuthor');
  if (footAuthor) footAuthor.textContent = isPink ? 'Nour Aassifar & Karim' : 'Karim Rachmoun';
}
function toggleTheme() {
  applyTheme(localStorage.getItem('cmh9theme') === 'dark' ? 'light' : 'dark');
}
function setMode3(variant) {
  const cur = localStorage.getItem('cmh9theme');
  applyTheme(cur === variant ? 'light' : variant);
  const pop = document.getElementById('mode3Pop');
  if (pop) pop.classList.remove('show');
}
(function initTheme() {
  const saved = localStorage.getItem('cmh9theme');
  applyTheme(['dark','pink','pink-light','pink-dark'].includes(saved) ? saved : 'light');
  const termsLink = document.getElementById('termsLink');
  const mode3Pop  = document.getElementById('mode3Pop');
  if (termsLink && mode3Pop) {
    termsLink.addEventListener('click', (e) => {
      e.preventDefault();
      mode3Pop.classList.toggle('show');
    });
    document.addEventListener('click', (e) => {
      if (!mode3Pop.contains(e.target) && e.target !== termsLink) mode3Pop.classList.remove('show');
    });
  }
})();

/* ── SPF generator logic ── */
(function () {
  const inp        = document.getElementById('spf-inp');
  const out         = document.getElementById('spf-out');
  const lineCount   = document.getElementById('spf-linecount');
  const statusPill  = document.getElementById('spf-status');
  const genBtn      = document.getElementById('spf-gen');
  const resetBtn    = document.getElementById('spf-reset');
  const copyBtn     = document.getElementById('spf-copy');
  const clearOutBtn = document.getElementById('spf-clear-out');
  const sampleBtn   = document.getElementById('spf-sample');

  const SAMPLE = [
    '192.168.1.1,mail.example.com',
    '10.0.0.5,newsletter.brand.io',
    '203.0.113.9,smtp.acme.org',
    '198.51.100.4,send.marketing.co',
    '172.16.0.1,outbound.mailing.net'
  ].join('\n');

  const IP_RE     = /^(\d{1,3}\.){3}\d{1,3}$/;
  const DOMAIN_RE = /^([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,63}$/;

  function isValidIp(ip) {
    if (!IP_RE.test(ip)) return false;
    return ip.split('.').every(function (o) { return Number(o) <= 255; });
  }

  function isValidDomain(d) {
    return d.length <= 253 && DOMAIN_RE.test(d);
  }

  function rootDomain(d) {
    const p = d.split('.');
    return p.length <= 2 ? d : p.slice(-2).join('.');
  }

  // Returns { rows, issues } — issues is a list of { line, text, reason }
  // for every non-empty input line that couldn't be turned into a record.
  function generate() {
    const lines = inp.value.split(/\r?\n/);
    const rows = [];
    const issues = [];
    for (let i = 0; i < lines.length; i++) {
      const l = lines[i].trim();
      if (!l) continue;
      const parts = l.split(',');
      if (parts.length < 2) { issues.push({ line: i + 1, text: l, reason: 'expected "IP,domain"' }); continue; }
      const ip   = parts[0].trim();
      const full = parts.slice(1).join(',').trim();
      if (!ip || !full) { issues.push({ line: i + 1, text: l, reason: 'expected "IP,domain"' }); continue; }
      if (!isValidIp(ip)) { issues.push({ line: i + 1, text: l, reason: 'invalid IPv4 address' }); continue; }
      if (!isValidDomain(full)) { issues.push({ line: i + 1, text: l, reason: 'invalid domain format' }); continue; }
      const root = rootDomain(full);
      rows.push(root + ',' + full + ',TXT,"v=spf1 ip4:' + ip + ' -all"');
    }
    return { rows: rows, issues: issues };
  }

  function setStatus(msg, type) {
    const dotClass = type ? ' ' + type : '';
    statusPill.innerHTML = `<span class="status-dot${dotClass}"></span>${msg}`;
    statusPill.className = 'status-pill' + dotClass;
  }

  function updateCounter() {
    const n = inp.value.split(/\r?\n/).filter(l => l.trim() !== '').length;
    lineCount.textContent = n + (n === 1 ? ' line' : ' lines');
    lineCount.className = 'spf-counter' + (n > 0 ? ' has-lines' : '');
  }

  const warnBox = document.getElementById('spf-warnings');

  function renderWarnings(issues) {
    if (!issues.length) { warnBox.style.display = 'none'; warnBox.innerHTML = ''; return; }
    const max = 6;
    const shown = issues.slice(0, max);
    warnBox.innerHTML = shown.map(function (w) {
      return '<div><span class="ln">L' + w.line + '</span><span>' + escapeHtml(w.text) + ' — ' + w.reason + '</span></div>';
    }).join('') + (issues.length > max ? '<div>+' + (issues.length - max) + ' more…</div>' : '');
    warnBox.style.display = 'block';
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, function (c) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
    });
  }

  function render() {
    const { rows, issues } = generate();
    out.value = rows.join('\n');
    renderWarnings(issues);
    if (rows.length > 0 && issues.length > 0) {
      setStatus(rows.length + ' generated, ' + issues.length + ' skipped', 'info');
    } else if (rows.length > 0) {
      setStatus(rows.length + ' record' + (rows.length > 1 ? 's' : '') + ' generated', 'ok');
    } else if (inp.value.trim()) {
      setStatus('no valid entries found', 'err');
    } else {
      setStatus('ready', '');
    }
    updateCounter();
  }

  genBtn.addEventListener('click', render);

  resetBtn.addEventListener('click', function () {
    inp.value = '';
    out.value = '';
    warnBox.style.display = 'none';
    warnBox.innerHTML = '';
    setStatus('ready', '');
    updateCounter();
  });

  sampleBtn.addEventListener('click', function () {
    inp.value = SAMPLE;
    render();
  });

  copyBtn.addEventListener('click', function () {
    if (!out.value) { setStatus('nothing to copy', 'err'); return; }
    navigator.clipboard.writeText(out.value).then(function () {
      setStatus('copied to clipboard', 'info');
      setTimeout(function () {
        const rows = generate().rows;
        if (rows.length > 0) setStatus(rows.length + ' record' + (rows.length > 1 ? 's' : '') + ' generated', 'ok');
        else setStatus('ready', '');
      }, 1800);
    }).catch(function () {
      out.select();
      document.execCommand('copy');
      setStatus('copied (fallback)', 'info');
    });
  });

  clearOutBtn.addEventListener('click', function () {
    out.value = '';
    setStatus('output cleared', '');
  });

  let debounce;
  inp.addEventListener('input', function () {
    updateCounter();
    clearTimeout(debounce);
    debounce = setTimeout(render, 220);
  });

  inp.addEventListener('paste', function () { setTimeout(function () { updateCounter(); render(); }, 30); });
  inp.addEventListener('cut',   function () { setTimeout(function () { updateCounter(); render(); }, 30); });

  updateCounter();
})();
</script>
</body>
</html>
