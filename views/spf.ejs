body.pink-dark .btn-extract { color: #0d0008; }
.btn-extract:hover { transform: translateY(-2px); box-shadow: 0 8px 32px var(--accent-glow); filter: brightness(1.08); }
.btn-extract:active { transform: translateY(0); }
.btn-extract:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }
.loading-wrap {
  margin-top: 14px; background: var(--bg-surface);
  border: 1px solid var(--line); border-radius: var(--r-sm);
